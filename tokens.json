{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "fizzyfeed brand tokens v0.1 — electric blue identity, name-agnostic (dev codename: kroma)",
  "color": {
    "electric": {
      "50":  { "$value": "#EAF1FF" },
      "100": { "$value": "#D0E1FF" },
      "200": { "$value": "#A3C4FF" },
      "300": { "$value": "#6FA1FF" },
      "400": { "$value": "#3B7DFF" },
      "500": { "$value": "#0A5CFF", "$description": "PRIMARY — electric blue" },
      "600": { "$value": "#0047E0", "$description": "small text on white (AA)" },
      "700": { "$value": "#0037B0" },
      "800": { "$value": "#002B85" },
      "900": { "$value": "#001F5C" },
      "950": { "$value": "#001438" }
    },
    "volt": {
      "300": { "$value": "#7BE9FF" },
      "400": { "$value": "#2FDDFF" },
      "500": { "$value": "#00D5FF" },
      "600": { "$value": "#00B2D6" },
      "700": { "$value": "#008CAD" }
    },
    "violet": {
      "400": { "$value": "#9A6BFF" },
      "500": { "$value": "#6333FF" },
      "600": { "$value": "#4A1FD9" }
    },
    "spark": { "500": { "$value": "#C8FF4D" } },
    "ink": {
      "50":  { "$value": "#F5F8FE" },
      "100": { "$value": "#E7EDF8" },
      "200": { "$value": "#C6D0E4" },
      "300": { "$value": "#9AA8C4" },
      "400": { "$value": "#6B7A99" },
      "500": { "$value": "#4A5774" },
      "600": { "$value": "#33405C" },
      "700": { "$value": "#1F2940" },
      "800": { "$value": "#131A2B" },
      "900": { "$value": "#0A0E1A" },
      "950": { "$value": "#05070E", "$description": "app background" }
    },
    "semantic": {
      "success": { "$value": "#00C853" },
      "warning": { "$value": "#FFB020" },
      "danger":  { "$value": "#FF4757" }
    }
  },
  "gradient": {
    "brand":  { "$value": ["#6333FF", "#0A5CFF", "#00D5FF"], "$angle": 135, "$description": "the chroma sweep used in the mark" },
    "bolt":   { "$value": ["#0A5CFF", "#00D5FF"], "$angle": 135, "$description": "card: Bolt" },
    "nebula": { "$value": ["#6333FF", "#0A5CFF"], "$angle": 135, "$description": "card: Nebula" },
    "aurora": { "$value": ["#00D5FF", "#00FFA3"], "$angle": 135, "$description": "card: Aurora" },
    "fizz":   { "$value": ["#C8FF4D", "#00E5A0"], "$angle": 135, "$description": "card: Lime Fizz" },
    "sunset": { "$value": ["#FF8A00", "#FF3D77"], "$angle": 135, "$description": "card: Sunset" },
    "coral":  { "$value": ["#FF5C5C", "#FF9E2C"], "$angle": 135, "$description": "card: Coral Pop" },
    "grape":  { "$value": ["#A855F7", "#6366FA"], "$angle": 135, "$description": "card: Grape Soda" }
  },
  "font": {
    "display": { "$value": "Space Grotesk" },
    "sans":    { "$value": "Inter" },
    "mono":    { "$value": "JetBrains Mono" }
  },
  "radius": {
    "sm":    { "$value": "8px" },
    "md":    { "$value": "14px" },
    "lg":    { "$value": "22px" },
    "xl":    { "$value": "32px" },
    "card":  { "$value": "28px" },
    "full":  { "$value": "999px" }
  },
  "shadow": {
    "glow-electric": { "$value": "0 0 0 1px rgb(10 92 255 / 0.25), 0 12px 48px rgb(10 92 255 / 0.35)" },
    "card":          { "$value": "0 8px 30px rgb(5 7 14 / 0.35)" }
  }
}
