{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ]
    }
  },
  "include": [
    "src/worker/**/*.ts",
    "src/shared/**/*.ts",
    "test/**/*.ts",
    "migrations/**/*.ts"
  ]
}