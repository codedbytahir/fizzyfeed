{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fizzyfeed",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": false
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fizzyfeed",
      "database_id": "07728bfc-341b-419d-82c9-89766f320180"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "8cf77c49f00a4cad8cdd6b954dcc9e3b"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "BUFFER_CLIENT_ID": "5WJXbtmJUS16xXQD7UnX2w-HJkKgjSE_V4eL2tni83T",
    "BUFFER_REDIRECT_URI": "https://fizzyfeed.developerfirr1.workers.dev/api/auth/buffer/callback",
    "APP_ORIGIN": "https://fizzyfeed.developerfirr1.workers.dev"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
